fn inverse_mapping(A: const matrix<float, 3, 3>, x: const vector<float, 3>) -> vector<float, 3> {
  let x_prime: matrix<float, 3, 1>;
  for i in range(0, 3) {
    x_prime[i, 0] = x[i];
  }
  let y_prime = A.inv @ x_prime;
  let y: vector<float, 3>;
  for i in range(0, 3) {
    y[i] = y_prime[i, 0];
  }
  return y;
}
fn main() {
  const A = [[3, 2, 4], [5, 2, 0], [0, 0, 1]];
  const x = [1, 2, 3];
  const y = inverse_mapping(A, x);
  for elem in y {
    print elem;
    print " ";
  }
}
